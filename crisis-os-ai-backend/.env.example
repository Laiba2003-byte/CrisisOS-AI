DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MAX_TOKENS=350
OPENROUTER_HTTP_REFERER="http://localhost:5173"
OPENROUTER_APP_TITLE="CrisisOS AI"
AI_CONFIDENCE_REVIEW_THRESHOLD=0.5
AI_DISABLE_RESPONSE_FORMAT=false
GEOCODING_PROVIDER=nominatim
GEOCODING_CACHE_TTL_HOURS=168
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="CrisisOSAI/0.1 (local-development)"
NOMINATIM_MAX_REQUESTS_PER_SECOND=1
GEOCODING_ALLOW_RAW_TEXT=false
DUPLICATE_LOOKBACK_HOURS=12
DUPLICATE_DISTANCE_KM=2.5
PORT=4000
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175"